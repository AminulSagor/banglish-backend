# Application Configuration
NODE_ENV=production
APP_PORT=3000

# Database Configuration
# IMPORTANT: Set these to your production database credentials
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USERNAME=your-production-db-username
DB_PASSWORD=your-production-db-password
DB_NAME=banglish_production
DB_SSL=true

# JWT Configuration
# IMPORTANT: Generate strong random secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for OAuth redirects)
FRONTEND_URL=https://your-production-domain.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/auth/google/callback

# Facebook OAuth Configuration
FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=your-production-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://your-api-domain.com/auth/facebook/callback

# Email Configuration (Zoho Mail)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-production-email@yourdomain.com
SMTP_PASS=your-production-zoho-password
SMTP_FROM=your-production-email@yourdomain.com
SMTP_FROM_NAME=Banglish

# SMS Configuration (SMS.net.bd)
SMS_API_KEY=your-production-sms-api-key
SMS_API_URL=https://api.sms.net.bd/sendsms
SMS_SENDER_ID=your-sender-id
SMS_CONTENT_ID=your-content-id

# Agora Configuration (for voice/video calls)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
