						],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}"]
						},
						"description": "Get user by ID. Requires JWT token."
					},
					"response": []
				},
				{
					"name": "Update User Profile",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"profile\": {\n    \"fullName\": \"John Doe Updated\",\n    \"country\": \"Bangladesh\",\n    \"division\": \"Sylhet\",\n    \"district\": \"Sylhet\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}"]
						},
						"description": "Update user profile. Users can update their own profile, admins can update any profile."
					},
					"response": []
				},
				{
					"name": "Create User (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@example.com\",\n  \"passwordHash\": \"$2b$10$hashed_password_here\",\n  \"role\": \"USER\",\n  \"fullName\": \"New User\",\n  \"country\": \"Bangladesh\",\n  \"division\": \"Dhaka\",\n  \"district\": \"Dhaka\",\n  \"isVerified\": true,\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/users",
							"host": ["{{base_url}}"],
							"path": ["users"]
						},
						"description": "Create a new user. Requires ADMIN role. Password should be pre-hashed."
					},
					"response": []
				},
				{
					"name": "Delete User (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}"]
						},
						"description": "Delete user by ID. Requires ADMIN role."
					},
					"response": []
				},
				{
					"name": "Deactivate User (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}/deactivate",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}", "deactivate"]
						},
						"description": "Deactivate user account. Requires ADMIN role."
					},
					"response": []
				},
				{
					"name": "Activate User (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}/activate",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}", "activate"]
						},
						"description": "Activate user account. Requires ADMIN role."
					},
					"response": []
				}
			],
			"description": "User management endpoints for CRUD operations"
		},
