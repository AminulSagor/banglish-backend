    {
      "name": "💬 Chat - Direct Messages",
      "description": "One-on-one direct messaging endpoints",
      "item": [
        {
          "name": "Get Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations"]
            },
            "description": "Get list of all users you've chatted with.\n\n**Returns:** List of conversation partners with last message and unread count."
          },
          "response": []
        },
        {
          "name": "Get Direct Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/direct/:userId?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "direct", ":userId"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ],
              "variable": [
                {
                  "key": "userId",
                  "value": "other-user-uuid"
                }
              ]
            },
            "description": "Get message history with a specific user.\n\n**Params:**\n- `userId` - The other user's ID\n- `page` - Page number (default: 1)\n- `limit` - Messages per page (default: 50)"
