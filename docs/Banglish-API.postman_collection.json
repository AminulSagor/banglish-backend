        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Database health check for load balancers"
          }
        },
        {
          "name": "Detailed Health",
          "request": {
            "method": "GET",
