              "path": ["billing", "check-minutes"],
              "query": [
                { "key": "minutes", "value": "5" }
              ]
            },
            "description": "Check if user has enough minutes"
          }
        },
        {
          "name": "Get Available Packages",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/billing/packages",
