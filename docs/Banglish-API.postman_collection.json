              ]
            },
            "description": "Get transaction history"
          }
        },
        {
          "name": "Purchase Minutes",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minutes\": 60,\n  \"paymentMethod\": \"STRIPE\"\n}"
            },
            "url": "{{baseUrl}}/billing/purchase",
            "description": "Initiate purchase of call minutes"
          }
        },
        {
          "name": "Check Minutes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/check-minutes?minutes=5",
