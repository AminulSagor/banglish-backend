        {
          "name": "Get My Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/transactions?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "transactions"],
              "query": [
