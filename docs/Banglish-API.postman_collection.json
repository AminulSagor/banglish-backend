{
  "info": {
    "name": "Banglish API",
    "description": "Complete API collection for Banglish Backend - Chat, Calls, and Presence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "packageId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
